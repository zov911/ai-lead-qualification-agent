# ── LLM (qualification) ─────────────────────────────────────────────
# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else mock
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (lead qualification is classification-like: low is usually enough)
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (re-runs a declined request on Anthropic's recommended model)
ANTHROPIC_FALLBACKS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── Embeddings (vector scoring) ─────────────────────────────────────
# ollama | hash  (hash = offline fallback, no model needed)
EMBEDDINGS_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Also: qwen3-embedding:4b / qwen3-embedding:8b for higher quality
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# ── Score blend (must add up to 1) ──────────────────────────────────
WEIGHT_LLM=0.5
WEIGHT_VECTOR=0.35
WEIGHT_RULES=0.15

# ── Inbound webhook auth ─────────────────────────────────────────────
# Callers send either header  x-webhook-secret: <secret>
# or an HMAC of the raw body   x-signature: sha256=<hex>
INBOUND_WEBHOOK_SECRET=

# ── Outbound: where scored leads go ─────────────────────────────────
# Any webhook (Zapier, Make, n8n, Slack workflow, your CRM). Signed with CRM_WEBHOOK_SECRET.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# HubSpot private app token (scope: crm.objects.contacts.write) → updates ai_* contact properties
HUBSPOT_PRIVATE_APP_TOKEN=
# Pipedrive → adds a note to the person
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=

PORT=8787
